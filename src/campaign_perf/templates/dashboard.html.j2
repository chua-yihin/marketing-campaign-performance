<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Campaign Performance Dashboard</title>
<meta name="description" content="Funnel, CAC, ROI and 30/60/90-day retention by acquiring channel, Google Analytics 360 sample (Aug 2016 to Aug 2017).">
<style>
  :root {
    color-scheme: light;
    --surface: #fcfcfb;
    --surface-2: #f3f2ef;
    --border: #e7e6e2;
    --text: #0b0b0b;
    --text-2: #52514e;
    --scale: #2a78d6;
    --cut: #eb6834;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--surface); color: var(--text);
    font: 15px/1.55 Inter, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  main { max-width: 1180px; margin: 0 auto; padding: 32px 16px 64px; }
  header p.kicker { margin: 0; color: var(--text-2); font-size: 13px; letter-spacing: .04em; text-transform: uppercase; }
  h1 { font-size: 30px; line-height: 1.2; margin: 6px 0 12px; }
  h2 { font-size: 20px; margin: 40px 0 8px; }
  p.lede { font-size: 17px; max-width: 820px; margin: 0 0 8px; }
  .muted { color: var(--text-2); }
  .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; margin: 24px 0 8px; }
  .tile { background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
  .tile .label { font-size: 13px; color: var(--text-2); }
  .tile .value { font-size: 26px; font-weight: 650; margin-top: 2px; font-variant-numeric: tabular-nums; }
  .tile .note { font-size: 13px; color: var(--text-2); }
  .chart { border: 1px solid var(--border); border-radius: 10px; padding: 8px; margin: 16px 0; background: var(--surface); }
  .chart > div { width: 100%; }
  details { margin: 8px 0 0; }
  summary { cursor: pointer; color: var(--text-2); font-size: 14px; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; font-size: 13.5px; font-variant-numeric: tabular-nums; margin: 8px 0; min-width: 640px; }
  th, td { padding: 6px 10px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th { color: var(--text-2); font-weight: 600; }
  ul.caveats li { margin-bottom: 4px; }
  a { color: #1c5cab; }
  footer { margin-top: 48px; font-size: 13px; color: var(--text-2); }
</style>
</head>
<body>
<main>
<header>
  <p class="kicker">Google Analytics 360 sample · {{ period }} · first-touch attribution</p>
  <h1>{{ headline }}</h1>
  <p class="lede">{{ lede }}</p>
  <p class="muted"><span class="swatch" style="background:var(--scale)"></span>{{ scale }} = channel to scale ·
     <span class="swatch" style="background:var(--cut)"></span>{{ cut }} = channel to cut ·
     <a href="https://github.com/chua-yihin/marketing-campaign-performance/blob/main/reports/memo.md">Read the 1-page memo</a> ·
     <a href="https://github.com/chua-yihin/marketing-campaign-performance/blob/main/docs/methodology.md">Methodology</a></p>
</header>

<section class="tiles" aria-label="Headline numbers">
  {% for t in tiles %}
  <div class="tile"><div class="label">{{ t.label }}</div><div class="value">{{ t.value }}</div><div class="note">{{ t.note }}</div></div>
  {% endfor %}
</section>

{% for c in charts %}
<h2>{{ c.heading }}</h2>
<div class="chart">{{ c.html }}</div>
{% if c.table %}
<details><summary>Show the numbers as a table</summary><div class="table-wrap">{{ c.table }}</div></details>
{% endif %}
{% endfor %}

<h2>Assumptions</h2>
<p class="muted">The sample has no cost data, so spend is <strong>assumed</strong>. Every value lives in
<code>config/assumptions.yaml</code>; change it and run <code>make all</code> to rebuild this page.</p>
<div class="table-wrap">{{ assumptions_table }}</div>

<h2>Caveats</h2>
<ul class="caveats">
  {% for c in caveats %}<li>{{ c }}</li>{% endfor %}
</ul>

<footer>Built by <code>make all</code> from <code>reports/tables/*.csv</code>. Every number on this page is read from those tables.
Source: <code>bigquery-public-data.google_analytics_sample</code>. Code: MIT.</footer>
</main>
</body>
</html>
